<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!--
  Installing a software update needs no password for the person at the keyboard: the helper
  re-checks the release's signature against the key on this computer and refuses anything that
  does not verify, so what it installs can only be a release signed by the project. Someone who
  is not at the keyboard (a remote or inactive session) is refused.
-->
<policyconfig>
  <vendor>Quire</vendor>
  <vendor_url>https://github.com/PoHsuanLai/slipway</vendor_url>
  <action id="org.quire.slipway.apply">
    <description>Install a software update</description>
    <message>Installing a software update needs your permission.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/slipway-apply</annotate>
  </action>
</policyconfig>
